rules_version = '2';

// Regole di sicurezza di HubVolley.
//
// Queste regole sono l'unica cosa che impedisce davvero a qualcuno di leggere
// o cambiare dati che non gli spettano: nascondere una pagina nell'app non
// protegge niente, perché il database è raggiungibile anche senza passare da
// lì. Tutto quello che conta va deciso qui.
//
// I SEI LIVELLI
//   webmanager      tutto, lettura e scrittura
//   amministratore  scrive comunicazioni e amministrazione; legge tutto
//   staff           scrive squadra, gare, comunicazioni; legge tutto
//   allenatore      come staff, più il lavoro tecnico; legge tutto
//   atleta          legge i propri dati e quelli di squadra; scrive solo
//                   quello che la riguarda (assenze, sensazioni, messaggi,
//                   risposte a convocazioni e sondaggi)
//   genitore        come l'atleta a cui è collegato
//
// IL PROFILO DEL WEB MASTER
// Il marchio e il nome di chi cura l'app (documento 'logo-webmaster') e gli
// account di livello web manager si modificano soltanto da web manager. Un
// amministratore della società gestisce tutti gli altri accessi, ma non può
// toccare quello di chi mantiene l'app né promuovere se stesso a quel
// livello: se potesse, il livello più alto non sarebbe più il più alto.
// Chi vuole legare il profilo a una persona sola e non al ruolo trova in
// fondo al file, commentato, il blocco con l'UID.
//
// COMPATIBILITÀ CON GLI ACCOUNT ESISTENTI
// Gli account creati prima hanno ruolo 'staff' con un campo booleano
// 'amministratore'. Finché non vengono aggiornati continuano a funzionare:
// un vecchio amministratore viene trattato come webmanager, un vecchio
// allenatore come allenatore. Senza questo, pubblicare le regole nuove
// chiuderebbe fuori tutti nello stesso istante — compreso chi deve
// rimetterle a posto.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- chi sei ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function haProfilo() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // Il ruolo effettivo, tradotto dal vecchio schema se serve.
    //
    // Il nome 'staff' esiste in entrambi gli schemi ma vuol dire cose diverse:
    // nel vecchio indicava chiunque non fosse un'atleta, nel nuovo è un
    // livello preciso. Senza distinguerli, un nuovo staff verrebbe letto come
    // web manager. Il campo 'schemaRuoli' dice quale dei due usare: lo scrive
    // l'app ogni volta che salva un account, e dove manca vale il vecchio.
    function schemaNuovo() {
      return haProfilo() && userDoc().get('schemaRuoli', 1) >= 2;
    }

    function ruolo() {
      return !haProfilo()
        ? 'anonimo'
        : schemaNuovo()
          ? userDoc().ruolo
          : (userDoc().ruolo == 'staff'
              ? (userDoc().get('amministratore', true) ? 'webmanager' : 'allenatore')
              : userDoc().ruolo);
    }

    function isWebManager()     { return ruolo() == 'webmanager'; }

    // Se un documento utente — quello che c'è adesso o quello che si sta per
    // scrivere — vale come web manager. Va letto con lo stesso criterio di
    // ruolo(), vecchio schema compreso, altrimenti basterebbe scrivere un
    // account in stile vecchio per aggirare il controllo.
    function docEWebManager(d) {
      return d.get('schemaRuoli', 1) >= 2
        ? d.get('ruolo', '') == 'webmanager'
        : (d.get('ruolo', '') == 'staff' && d.get('amministratore', true) == true);
    }
    function isAmministratore() { return ruolo() == 'amministratore'; }
    function isStaffBase()      { return ruolo() == 'staff'; }
    function isAllenatore()     { return ruolo() == 'allenatore'; }

    // Chiunque faccia parte dello staff, a qualunque livello: serve per le
    // letture, che sono aperte a tutti e sei i livelli tranne dove indicato.
    function isTecnico() {
      return isWebManager() || isAmministratore() || isStaffBase() || isAllenatore();
    }

    // L'atleta a cui questo account è collegato: vale anche per i genitori,
    // che vedono e scrivono per la propria figlia.
    function isOwnAtleta(atletaId) {
      return haProfilo() && userDoc().get('atletaId', '') == atletaId;
    }

    // ---------- cosa puoi scrivere ----------
    // Un'area per volta, come nella tabella dei ruoli.

    function scriveSquadra() {
      return isWebManager() || isStaffBase() || isAllenatore();
    }
    function scriveGare() {
      return isWebManager() || isStaffBase() || isAllenatore();
    }
    function scriveComunicazioni() {
      return isWebManager() || isAmministratore() || isStaffBase() || isAllenatore();
    }
    function scriveTecnico() {
      return isWebManager() || isAllenatore();
    }
    function scriveAmministrazione() {
      return isWebManager() || isAmministratore();
    }

    // ---------- account e configurazione ----------

    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isTecnico());

      // Creare account e cambiare ruoli è amministrazione: se chiunque
      // potesse scrivere qui, si darebbe da sé il livello che preferisce e
      // tutto il resto di queste regole non varrebbe niente.
      //
      // In più, il livello web manager è riservato a chi già lo è. Un
      // amministratore gestisce tutti gli altri accessi, ma non può né
      // modificare o cancellare un account web manager, né crearne uno, né
      // promuovere se stesso: sono le tre strade che altrimenti porterebbero
      // al controllo completo dell'app partendo da un ruolo più basso.
      allow create: if isWebManager() ||
        (scriveAmministrazione() && !docEWebManager(request.resource.data));
      allow update: if isWebManager() ||
        (scriveAmministrazione() &&
          !docEWebManager(resource.data) &&
          !docEWebManager(request.resource.data));
      allow delete: if isWebManager() ||
        (scriveAmministrazione() && !docEWebManager(resource.data));
    }

    match /impostazioni/{docId} {
      // Lettura aperta: il logo serve alla pagina di accesso, prima che
      // qualcuno sia entrato.
      allow read: if true;
      allow write: if scriveAmministrazione();
    }

    // Immagini di testata delle pagine, più il marchio di chi cura l'app.
    // Stanno nella stessa collezione perché sono tutte immagini, ma non
    // valgono lo stesso: le testate sono grafica della società e le cambia
    // chi si occupa di amministrazione, il profilo del web master identifica
    // chi mantiene l'app e non si modifica da fuori.
    match /grafichePagine/{chiave} {
      allow read: if isSignedIn();
      allow write: if chiave == 'logo-webmaster'
        ? isWebManager()
        : scriveAmministrazione();
    }

    match /loginLog/{uid} {
      allow read: if isTecnico();
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    match /pushTokens/{gettone} {
      allow read: if isTecnico();
      // Ciascuno registra il proprio dispositivo.
      allow write: if isSignedIn();
    }

    // Quando una persona ha aperto bacheca e messaggi. Ognuno scrive la
    // propria riga, lo staff le legge tutte.
    match /letture/{uid} {
      allow read: if isTecnico() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isSignedIn() && request.auth.uid == uid;
    }

    // ---------- squadra ----------

    match /atlete/{atletaId} {
      // La scheda completa contiene contatti, codice fiscale, infortuni e
      // quote: la vede lo staff, e l'atleta solo la propria.
      allow read: if isTecnico() || isOwnAtleta(atletaId);
      allow create, delete: if scriveSquadra();

      // Le quote sono un campo dentro la scheda dell'atleta, non una
      // raccolta a parte: per questo chi si occupa di amministrazione può
      // modificare la scheda, ma soltanto se tocca le rate e nient'altro.
      // Senza questa riga il tesoriere non potrebbe registrare un pagamento;
      // senza il vincolo sui campi, potrebbe cambiare qualsiasi altro dato.
      allow update: if scriveSquadra() ||
        (scriveAmministrazione() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rateQuota']));
    }

    match /rosa/{atletaId} {
      allow read: if isSignedIn();
      allow write: if scriveSquadra();
    }

    match /allenamenti/{allenamentoId} {
      allow read: if isSignedIn();
      allow write: if scriveSquadra();
    }

    match /testAtletici/{testId} {
      allow read: if isTecnico() || isOwnAtleta(resource.data.atletaId);
      allow write: if scriveSquadra();
    }

    // ---------- gare ----------

    match /partite/{partitaId} {
      allow read: if isSignedIn();
      allow write: if scriveGare();

      // La conferma della convocazione la dà l'atleta.
      match /risposte/{atletaId} {
        allow read: if isTecnico() || isOwnAtleta(atletaId);
        allow write: if isOwnAtleta(atletaId) || scriveGare();
      }
    }

    match /risultatiCampionato/{risultatoId} {
      allow read: if isSignedIn();
      allow write: if scriveGare();
    }

    match /orariCampi/{slotId} {
      allow read: if isSignedIn();
      allow write: if scriveGare();
    }

    // ---------- lavoro tecnico ----------

    match /esercizi/{esercizioId} {
      allow read: if isSignedIn();
      allow write: if scriveTecnico();
    }

    match /pianiAllenamento/{pianoId} {
      allow read: if isSignedIn();
      allow write: if scriveTecnico();
    }

    match /risorseTecniche/{risorsaId} {
      allow read: if isSignedIn();
      allow write: if scriveTecnico();
    }

    match /clip/{clipId} {
      allow read: if isSignedIn();
      allow write: if scriveTecnico();
    }

    match /sistemaGioco/{docId} {
      allow read: if isSignedIn();
      allow write: if scriveTecnico();
    }

    match /obiettivi/{obiettivoId} {
      allow read: if isSignedIn();
      allow write: if scriveTecnico();
    }

    // Lo scout è in sola lettura per le atlete: i numeri servono a decidere
    // gli allenamenti, e se li potesse correggere chiunque smetterebbero di
    // valere qualcosa.
    match /scout/{partitaId} {
      allow read: if isSignedIn();
      allow write: if scriveTecnico();
    }

    match /valutazioniTecniche/{valutazioneId} {
      allow read: if isTecnico() || isOwnAtleta(resource.data.atletaId);
      allow write: if scriveTecnico();
    }

    match /programmiIndividuali/{programmaId} {
      allow read: if isTecnico() || isOwnAtleta(resource.data.atletaId);
      allow write: if scriveTecnico();
    }

    // La spunta della seduta fatta la mette l'atleta.
    match /sedutePersonali/{sedutaId} {
      allow read: if isTecnico() || isOwnAtleta(resource.data.atletaId);
      allow create: if scriveTecnico() || isOwnAtleta(request.resource.data.atletaId);
      allow update: if scriveTecnico() || isOwnAtleta(resource.data.atletaId);
      allow delete: if scriveTecnico() || isOwnAtleta(resource.data.atletaId);
    }

    // ---------- quello che riguarda la singola atleta ----------

    match /assenze/{assenzaId} {
      allow read: if isTecnico() || isOwnAtleta(resource.data.atletaId);
      allow create: if isOwnAtleta(request.resource.data.atletaId) || scriveSquadra();
      allow update, delete: if isOwnAtleta(resource.data.atletaId) || scriveSquadra();
    }

    match /sensazioni/{sensazioneId} {
      allow read: if isTecnico() || isOwnAtleta(resource.data.atletaId);
      allow create: if isOwnAtleta(request.resource.data.atletaId) || scriveSquadra();
      allow update: if isOwnAtleta(resource.data.atletaId) || scriveSquadra();
    }

    // ---------- comunicazione ----------

    match /comunicazioni/{comId} {
      allow read: if isSignedIn();
      allow write: if scriveComunicazioni();
    }

    match /sondaggi/{sondaggioId} {
      allow read: if isSignedIn();
      allow write: if scriveComunicazioni();

      match /risposte/{atletaId} {
        allow read: if isSignedIn();
        allow write: if isOwnAtleta(atletaId) || scriveComunicazioni();
      }
    }

    // La conversazione privata fra un'atleta e lo staff.
    //
    // Ogni livello dello staff può scrivere qui, perché rispondere a una
    // ragazza non è un privilegio amministrativo. L'atleta scrive nella
    // propria e in nessun'altra: è la riga che le permette di mandarti un
    // messaggio, e va tenuta d'occhio se un giorno smettono di arrivare.
    match /conversazioni/{atletaId} {
      allow read: if isTecnico() || isOwnAtleta(atletaId);
      allow write: if scriveComunicazioni() || isOwnAtleta(atletaId);

      match /messaggi/{msgId} {
        allow read: if isTecnico() || isOwnAtleta(atletaId);
        allow create: if scriveComunicazioni() || isOwnAtleta(atletaId);
        // I messaggi non si correggono né si cancellano: una conversazione
        // modificabile a posteriori non è più una prova di quello che è stato
        // detto, e qui dentro si parla anche di assenze e di salute.
        allow update, delete: if false;
      }
    }
  }
}

// ---------------------------------------------------------------------------
// FACOLTATIVO — LEGARE IL PROFILO A UNA PERSONA SOLA
//
// Le regole sopra riservano il profilo del web master a chi ha quel livello.
// Finché il web manager sei soltanto tu, è già abbastanza: nessun altro
// account può modificare il tuo né crearsene uno pari.
//
// Se un giorno dovessero esserci due web manager e volessi comunque che il
// profilo resti tuo e di nessun altro, incolla qui sotto il tuo UID e
// sostituisci le due funzioni isWebManager() usate in /users e in
// /grafichePagine con isWebMaster().
//
// L'UID si trova nella console Firebase, in Authentication > Users: è la
// stringa nella colonna "User UID" della riga con la tua email.
//
//     function isWebMaster() {
//       return request.auth != null &&
//         request.auth.uid == 'INCOLLA_QUI_IL_TUO_UID';
//     }
//
// Attenzione: con l'UID sbagliato nessuno può più modificare gli account web
// manager né il profilo del web master, e per rimediare bisogna tornare qui
// nella console. Fai la prova subito dopo aver pubblicato.
// ---------------------------------------------------------------------------
